# Environment Variables Configuration
# Copy this file to .env and fill in your actual private credentials.
# NEVER commit .env to GitHub (it is in .gitignore).

# Discord Incoming Webhook URL for Private Operations Dispatch
# Configure this in your Netlify Dashboard (Site settings > Environment variables)
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/YOUR_WEBHOOK_ID/YOUR_WEBHOOK_TOKEN
